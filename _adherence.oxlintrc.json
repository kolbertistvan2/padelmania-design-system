{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/commerce/**",
              "components/core/**",
              "components/finder/**",
              "components/navigation/**",
              "components/promo/**",
              "components/quiz/**",
              "export-buttons.js",
              "sablonkeszlet/**",
              "ui_kits/mobile-app/**",
              "video-download.js"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:logoSrc|title|actions|search|children|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: logoSrc, title, actions, search, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|caps|size|iconLeft|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, caps, size, iconLeft."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|pill|fullWidth|disabled|iconLeft|iconRight|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, pill, fullWidth, disabled, iconLeft, iconRight, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CartLineItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|variant|image|price|quantity|onQuantityChange|onRemove|stepper|key|ref|className|style|children)$/]",
        "message": "<CartLineItem> doesn't accept that prop. Declared props: name, variant, image, price, quantity, onQuantityChange, onRemove, stepper."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|image|style|key|ref|className|style|children)$/]",
        "message": "<CategoryCard> doesn't accept that prop. Declared props: label, image, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|kind|selected|iconLeft|onClick|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, kind, selected, iconLeft, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:toggle|chip)$/]",
        "message": "<Chip> kind must be one of 'toggle' | 'chip'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CourtCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|address|isOpen|distanceKm|rating|reviewCount|favorite|expanded|onToggle|onFavorite|onNavigate|onCall|onDetail|key|ref|className|style|children)$/]",
        "message": "<CourtCard> doesn't accept that prop. Declared props: name, address, isOpen, distanceKm, rating, reviewCount, favorite, expanded, onToggle, onFavorite, onNavigate, onCall, onDetail."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCta'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|icon|key|ref|className|style|children)$/]",
        "message": "<FeatureCta> doesn't accept that prop. Declared props: title, subtitle, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|weight|color|title|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, weight, color, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|iconLeft|iconRight|onDark|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, iconLeft, iconRight, onDark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ManiaPlusBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|ctaLabel|markSrc|key|ref|className|style|children)$/]",
        "message": "<ManiaPlusBanner> doesn't accept that prop. Declared props: title, subtitle, ctaLabel, markSrc."
      },
      {
        "selector": "JSXOpeningElement[name.name='ManiaPriceBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:memberPrice|savings|isMember|markSrc|onJoin|key|ref|className|style|children)$/]",
        "message": "<ManiaPriceBox> doesn't accept that prop. Declared props: memberPrice, savings, isMember, markSrc, onJoin."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|iconImage|label|hint|highlight|disabled|last|style|key|ref|className|style|children)$/]",
        "message": "<MenuRow> doesn't accept that prop. Declared props: icon, iconImage, label, hint, highlight, disabled, last, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NoticeBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|children|onAccept|onDeny|acceptLabel|denyLabel|onClose|key|ref|className|style|children)$/]",
        "message": "<NoticeBanner> doesn't accept that prop. Declared props: icon, children, onAccept, onDeny, acceptLabel, denyLabel, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:price|regularPrice|size|onSale|rule|key|ref|className|style|children)$/]",
        "message": "<PriceBlock> doesn't accept that prop. Declared props: price, regularPrice, size, onSale, rule."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceBlock'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<PriceBlock> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|image|price|regularPrice|memberPrice|onSale|demo|memberMarkSrc|width|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: name, image, price, regularPrice, memberPrice, onSale, demo, memberMarkSrc, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|total|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, total."
      },
      {
        "selector": "JSXOpeningElement[name.name='QtyStepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|onChange|key|ref|className|style|children)$/]",
        "message": "<QtyStepper> doesn't accept that prop. Declared props: value, min, max, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuizOptionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|index|label|description|details|levelBadge|icon|image|priceLabel|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<QuizOptionCard> doesn't accept that prop. Declared props: variant, index, label, description, details, levelBadge, icon, image, priceLabel, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScreenHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|onBack|onClose|right|key|ref|className|style|children)$/]",
        "message": "<ScreenHeader> doesn't accept that prop. Declared props: title, onBack, onClose, right."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|badge|onSeeAll|seeAllLabel|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: title, badge, onSeeAll, seeAllLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|key|ref|className|style|children)$/]",
        "message": "<SegmentItem> doesn't accept that prop. Declared props: id, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|radius|key|ref|className|style|children)$/]",
        "message": "<Skeleton> doesn't accept that prop. Declared props: width, height, radius."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|key|ref|className|style|children)$/]",
        "message": "<TabBarItem> doesn't accept that prop. Declared props: id, label, icon."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
